name: CI

on:
  push:
    branches: [main, master, "codex/**"]
    tags: ["v*"]
  pull_request:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  optimizer-native:
    runs-on: windows-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Compilar helper nativo Windows
        shell: pwsh
        run: |
          rustup toolchain install 1.88.0 --profile minimal
          rustup run 1.88.0 cargo test --manifest-path apps/desktop/optimizer-native/Cargo.toml --locked
          rustup run 1.88.0 cargo build --manifest-path apps/desktop/optimizer-native/Cargo.toml --release --locked
          if (!(Test-Path apps/desktop/optimizer-native/target/release/adr-workspace-optimizer.exe)) { throw "Helper nativo ausente" }

  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9.15.9
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      # `dist` e gitignored e cada pacote resolve o irmao por `exports -> dist/index.d.ts`:
      # sem build antes, `pnpm typecheck` nao acha `@adr/contracts` (TS2307). Local passa
      # porque o dist sobra de algum `pnpm dev`. Este build cobre o do @adr/desktop.
      - run: pnpm build
      - run: pnpm typecheck
      - run: pnpm lint
      - run: pnpm test

  # Pack only on tags — does not publish (manual approval still required).
  pack:
    if: startsWith(github.ref, 'refs/tags/')
    needs: verify
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 9.15.9
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      # O job tem checkout limpo; não herda os dist do job verify.
      - run: pnpm build
      - run: pnpm ensure:electron
      - run: pnpm --filter @adr/desktop run pack:linux --publish never
      - run: node scripts/release-artifacts.mjs
      - uses: actions/upload-artifact@v4
        with:
          name: linux-packages
          retention-days: 14
          path: |
            apps/desktop/release/*.deb
            apps/desktop/release/*.AppImage
            apps/desktop/release/SHA256SUMS
            apps/desktop/release/sbom.cdx.json
