{
  "manifest_version": 3,
  "name": "ADR CRM no WhatsApp e Gmail",
  "version": "0.15.5",
  "minimum_chrome_version": "102",
  "update_url": "https://app.adragencia.com.br/extension-updates/update_manifest.xml",
  "description": "Traz o CRM ao WhatsApp Web e ao Gmail, com consulta de contatos e redação assistida de e-mails.",
  "icons": {
    "16": "icons/adr-16.png",
    "32": "icons/adr-32.png",
    "48": "icons/adr-48.png",
    "128": "icons/adr-128.png"
  },
  "permissions": ["storage", "cookies", "scripting"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://mail.google.com/*",
    "https://app.adragencia.com.br/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js" },
  "storage": { "managed_schema": "managed-storage-schema.json" },
  "options_page": "options.html",
  "action": {
    "default_title": "ADR CRM no WhatsApp e Gmail",
    "default_icon": {
      "16": "icons/adr-16.png",
      "32": "icons/adr-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "run_at": "document_idle",
      "js": ["shared.js", "wa-dom.js", "content.js"],
      "css": ["styles.css"]
    },
    {
      "matches": ["https://mail.google.com/mail/*"],
      "run_at": "document_idle",
      "js": ["gmail-content.js"]
    }
  ]
}
