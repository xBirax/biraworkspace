{
  "name": "@adr/desktop",
  "version": "0.2.0-local.3",
  "private": true,
  "description": "BiraWorkspace — ambiente pessoal para Windows e Linux",
  "author": "BiraWorkspace <biraworkspace@users.noreply.github.com>",
  "homepage": "https://github.com/xBirax/biraworkspace",
  "type": "module",
  "main": "dist/main/index.bundle.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/bundle-main.mjs && node ./scripts/copy-preload.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "corepack pnpm build && electron .",
    "pack:win": "corepack pnpm build && electron-builder --win nsis --x64",
    "pack:dir": "corepack pnpm build && electron-builder --win --dir --x64",
    "pack:deb": "corepack pnpm build && electron-builder --linux deb --x64",
    "pack:appimage": "corepack pnpm build && electron-builder --linux AppImage --x64",
    "pack:linux": "corepack pnpm build && electron-builder --linux deb AppImage --x64",
    "ensure:electron": "node node_modules/electron/install.js",
    "coverage": "vitest run --coverage --coverage.include=src/main/**/*.ts --coverage.exclude=**/*.test.ts --coverage.reporter=text-summary --coverage.reporter=html"
  },
  "devDependencies": {
    "@adr/app-state": "workspace:*",
    "@adr/contracts": "workspace:*",
    "@adr/crm-core": "workspace:*",
    "@adr/crm-desktop-adapter": "workspace:*",
    "@adr/partitions": "workspace:*",
    "@adr/service-adapters": "workspace:*",
    "@adr/view-lifecycle": "workspace:*",
    "@adr/workspaces": "workspace:*",
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "3.2.7",
    "@wppconnect/wa-js": "4.8.1",
    "concurrently": "9.1.2",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "25.1.8",
    "electron-updater": "^6.8.9",
    "esbuild": "0.25.1",
    "ical.js": "2.2.1",
    "typescript": "^5.8.2",
    "vite": "6.2.2",
    "vitest": "3.2.7",
    "zod": "3.24.2"
  },
  "build": {
    "appId": "com.bira.workspace",
    "electronDist": "node_modules/electron/dist",
    "afterSign": "scripts/vmp-sign.cjs",
    "afterPack": "scripts/local-icon.cjs",
    "productName": "BiraWorkspace",
    "executableName": "biraworkspace",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/index.bundle.cjs",
      "dist/main/calendar-worker.bundle.cjs",
      "dist/preload/**/*",
      "dist/shell/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [],
    "win": {
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "build/icon.ico",
          "to": "biraworkspace.ico"
        },
        {
          "from": "build/backup-profile.ps1",
          "to": "backup-profile.ps1"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BiraWorkspace-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BiraWorkspace",
      "include": "build/installer.nsh"
    },
    "deb": { "packageName": "biraworkspace", "recommends": ["libsecret-tools"], "afterInstall": "build/bira-after-install.sh", "afterRemove": "build/bira-after-remove.sh" },
    "linux": {
      "extraResources": [
        {"from":"build/biraworkspace.apparmor","to":"biraworkspace.apparmor"},
        {"from":"build/backup-profile-linux.py","to":"backup-profile-linux.py"},
        {"from":"scripts/setup-voice-linux.sh","to":"models/setup-voice-linux.sh"},
        {"from":"scripts/setup-translation.py","to":"models/setup-translation.py"},
        {"from":"src/main/translate-worker.py","to":"models/translate-worker.py"}
      ],
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "maintainer": "BiraWorkspace <biraworkspace@users.noreply.github.com>",
      "artifactName": "BiraWorkspace-${version}-${arch}.${ext}",
      "icon": "build/icons",
      "desktop": {
        "Name": "BiraWorkspace",
        "StartupWMClass": "biraworkspace"
      }
    },
    "publish": [],
    "asarUnpack": [
      "dist/main/calendar-worker.bundle.cjs"
    ]
  }
}
