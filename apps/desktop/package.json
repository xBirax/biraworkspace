{
  "name": "@adr/desktop",
  "version": "0.1.53",
  "private": true,
  "description": "ADR Workspace desktop client (Electron; Linux package + Windows/macOS dev)",
  "author": "ADR Agencia <dev@adragencia.com.br>",
  "homepage": "https://app.adragencia.com.br",
  "type": "module",
  "main": "dist/main/index.bundle.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/bundle-main.mjs && node ./scripts/copy-preload.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "corepack pnpm build && electron .",
    "pack:win": "corepack pnpm build && electron-builder --win nsis --x64",
    "pack:dir": "corepack pnpm build && electron-builder --win --dir --x64",
    "pack:deb": "corepack pnpm build && electron-builder --linux deb --x64",
    "pack:appimage": "corepack pnpm build && electron-builder --linux AppImage --x64",
    "pack:linux": "corepack pnpm build && electron-builder --linux deb AppImage --x64",
    "ensure:electron": "node node_modules/electron/install.js",
    "coverage": "vitest run --coverage --coverage.include=src/main/**/*.ts --coverage.exclude=**/*.test.ts --coverage.reporter=text-summary --coverage.reporter=html"
  },
  "devDependencies": {
    "@adr/app-state": "workspace:*",
    "@adr/contracts": "workspace:*",
    "@adr/crm-core": "workspace:*",
    "@adr/crm-desktop-adapter": "workspace:*",
    "@adr/partitions": "workspace:*",
    "@adr/service-adapters": "workspace:*",
    "@adr/view-lifecycle": "workspace:*",
    "@adr/workspaces": "workspace:*",
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "3.0.8",
    "concurrently": "9.1.2",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "25.1.8",
    "electron-updater": "^6.8.9",
    "esbuild": "0.25.1",
    "ical.js": "2.2.1",
    "typescript": "^5.8.2",
    "vite": "6.2.2",
    "vitest": "3.0.8",
    "zod": "3.24.2"
  },
  "build": {
    "appId": "br.com.adragencia.workspace",
    "electronDist": "node_modules/electron/dist",
    "afterSign": "scripts/vmp-sign.cjs",
    "productName": "ADR Workspace",
    "executableName": "adr-workspace",
    "icon": "build/icon.png",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/index.bundle.cjs",
      "dist/main/calendar-worker.bundle.cjs",
      "dist/preload/**/*",
      "dist/shell/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../../vendor",
        "to": "vendor"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "optimizer-native/target/release/adr-workspace-optimizer.exe",
          "to": "optimizer-native/adr-workspace-optimizer.exe"
        },
        {
          "from": "build/backup-profile.ps1",
          "to": "backup-profile.ps1"
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ADR-Workspace-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ADR Workspace",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Network",
      "maintainer": "ADR Agencia <dev@adragencia.com.br>",
      "artifactName": "adr-workspace_${version}_${arch}.${ext}",
      "icon": "build/icons",
      "desktop": {
        "Name": "ADR Workspace",
        "StartupWMClass": "ADRWorkspace"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ADRAGENCIACRM",
        "repo": "adrworkspace-releases",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "dist/main/calendar-worker.bundle.cjs"
    ]
  }
}
