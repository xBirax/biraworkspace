{
    "name":  "adr-workspace",
    "private":  true,
    "type":  "module",
    "packageManager":  "pnpm@9.15.9",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "scripts":  {
                    "typecheck":  "corepack pnpm -r --if-present run typecheck",
                    "test":  "corepack pnpm -r --if-present run test",
                    "lint":  "eslint .",
                    "lint:fix":  "eslint . --fix",
                    "format":  "prettier --write .",
                    "format:check":  "prettier --check .",
                    "build":  "corepack pnpm -r --if-present run build",
                    "dev":  "corepack pnpm build \u0026\u0026 node scripts/ensure-electron.mjs \u0026\u0026 corepack pnpm --filter @adr/desktop exec electron .",
                    "ensure:electron":  "node scripts/ensure-electron.mjs",
                    "update:local":  "node scripts/local-update-disabled.mjs",
                    "release:artifacts":  "node scripts/release-artifacts.mjs"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.22.0",
                            "@types/node":  "^22.13.10",
                            "esbuild":  "0.25.1",
                            "eslint":  "^9.22.0",
                            "extract-zip":  "2.0.1",
                            "globals":  "^16.0.0",
                            "prettier":  "^3.5.3",
                            "typescript":  "^5.8.2",
                            "typescript-eslint":  "^8.26.1",
                            "vitest":  "^3.0.8",
                            "zod":  "3.24.2"
                        }
}