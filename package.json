{
  "name": "adr-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "corepack pnpm -r --if-present run build",
    "dev": "corepack pnpm build && node scripts/ensure-electron.mjs && corepack pnpm --filter @adr/desktop exec electron .",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "update:local": "corepack pnpm --filter @adr/desktop run pack:dir && node scripts/update-local.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "esbuild": "0.25.1",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8",
    "zod": "3.24.2"
  }
}
